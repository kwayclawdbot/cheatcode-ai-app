{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@cheatcode/shared": [
        "../../packages/shared/api.ts"
      ],
      "@cheatcode/shared/chart-bridge": [
        "../../packages/shared/chart-bridge.ts"
      ]
    }
  },
  "include": [
