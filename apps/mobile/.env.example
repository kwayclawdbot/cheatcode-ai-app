# apps/mobile/.env — copy this file to `.env` and fill in the two keys.
# Real values are never committed; the repository is public.
#
# There are two ways to run the app, and the only difference is these four lines.
#
#   HOSTED (what the owner uses): the database and the API are in the cloud.
#   `npx expo start` still has to run so Expo Go can fetch the app's code over
#   Wi-Fi, but nothing else on the laptop does. No local Supabase, no API server.
#
#   ALL-LOCAL (development): the database and the API run on this Mac. The phone
#   reaches them over the LAN address, so both must be running.
#
# The working copies live beside this file as `.env.hosted` and `.env.laptop`;
# switch with `cp .env.hosted .env` (or `.env.laptop`) and restart with
# `npx expo start --clear`. Expo bakes these values into the bundle at start.

# ---- HOSTED -----------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://eqepjztjmzmpvmlqsdiz.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=          # Supabase dashboard → Project → API keys → anon
EXPO_PUBLIC_API_BASE=https://cheatcode-ai-api.vercel.app
EXPO_PUBLIC_VAPID_PUBLIC_KEY=           # same public half the API serves; see docs/ENV.md

# ---- ALL-LOCAL --------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=http://<this-mac-LAN-ip>:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=        # from `supabase status`
# EXPO_PUBLIC_API_BASE=http://<this-mac-LAN-ip>:3000
# EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# ---- OPTIONAL ---------------------------------------------------------------
# EXPO_PUBLIC_FIXTURES=1     every screen renders from local fixtures, no network
# EXPO_PUBLIC_DEV_TOOLS=1    the Account screen shows the simulate-trade button
