# workers/kai-live/.env.local  — never commit the real file (.gitignore covers .env.*)
#
# Only OPENAI_API_KEY has to live here. Everything else is read from
# apps/api/.env.local so there is one copy of the Supabase and Anthropic keys on
# the machine, not two that can drift apart.

# The voice. Owner's key: ~/breakout-alert-system/.env
OPENAI_API_KEY=

# Optional overrides — the defaults are in src/config.ts
# LIVE_API_BASE=http://localhost:3000
# SHOW_BUDGET_USD_PER_HOUR=3.00
# SHOW_PREP_DEPTH=2
# SHOW_MAX_SEGMENTS=0
# LIVE_TTS_MODEL=gpt-4o-mini-tts
# LIVE_TTS_VOICE_KAI=ash
# LIVE_TTS_VOICE_COHOST=coral
# LIVE_TTS_SPEED=1.0
# LIVE_TTS_USD_PER_1K_CHARS=0.015
# LIVE_AUDIO_BUCKET=live-audio
# LIVE_STAGE_USER_EMAIL=stage@kai-live.local
# LIVE_WINNER_HOLD_DAYS=3
