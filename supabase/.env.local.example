# Local Supabase values for the Cheat Code AI v1 slice.
# Produced by `supabase status` against the local stack in this repo.
#
# These are the Supabase demo keys shipped with every local CLI install. They
# are NOT secrets and they only work against 127.0.0.1. Never reuse this file
# for a hosted project.
#
# Copy into your lane's env file:
#   apps/api/.env.local     -> SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   apps/mobile/.env        -> EXPO_PUBLIC_* (use the Mac's LAN IP instead of
#                              127.0.0.1 when testing on a physical phone)

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
